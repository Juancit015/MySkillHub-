---
import { getCollection } from "astro:content";

export interface Props {
  current?: string;
  locale?: "en" | "es";
  base?: string;
  variant?: "sidebar" | "chips";
}

const { current, locale = "en", base = "", variant = "sidebar" } = Astro.props;

const categories = (await getCollection("categories")).sort((a, b) => a.data.order - b.data.order);
const skills = await getCollection("skills");

const counts = new Map<string, number>();
for (const skill of skills) {
  const c = skill.data.category_id;
  counts.set(c, (counts.get(c) || 0) + 1);
}

const labels = {
  all: locale === "es" ? "Todas" : "All",
  categories: locale === "es" ? "Categorías" : "Categories",
  type: locale === "es" ? "Tipo" : "Type",
  types: locale === "es"
    ? { skill: "Skill", plugin: "Plugin", tool: "Herramienta", collection: "Colección" }
    : { skill: "Skill", plugin: "Plugin", tool: "Tool", collection: "Collection" },
};

const allHref = `${base}/`;
const typeCounts = { skill: 0, plugin: 0, tool: 0, collection: 0 } as Record<string, number>;
for (const s of skills) typeCounts[s.data.type]++;
---

{variant === "chips" ? (
  <nav class="chips-bar" aria-label={labels.categories}>
    <span class="chips-label">{labels.categories}</span>
    <a href={allHref} class:list={["chip-link", { active: !current }]}>
      <span>{labels.all}</span>
      <span class="count">{skills.length}</span>
    </a>
    {categories.map((cat) => (
      <a href={`${base}/categories/${cat.data.id}`} class:list={["chip-link", { active: current === cat.data.id }]}>
        <span>{cat.data.name[locale]}</span>
        <span class="count">{counts.get(cat.data.id) || 0}</span>
      </a>
    ))}
  </nav>
) : (
  <aside class="sidebar">
    <div class="filter-block">
      <h3>{labels.categories}</h3>
      <a href={allHref} class={`filter-item ${!current ? "active" : ""}`}>
        <span>{labels.all}</span>
        <span class="count">{skills.length}</span>
      </a>
      {categories.map((cat) => (
        <a href={`${base}/categories/${cat.data.id}`} class={`filter-item ${current === cat.data.id ? "active" : ""}`}>
          <span>{cat.data.name[locale]}</span>
          <span class="count">{counts.get(cat.data.id) || 0}</span>
        </a>
      ))}
    </div>
    <div class="filter-block">
      <h3>{labels.type}</h3>
      <div class="type-chips">
        {(["skill", "plugin", "tool", "collection"] as const).map((t) => (
          <div class="filter-item" data-type-filter={t}>
            <span>{labels.types[t]}</span>
            <span class="count">{typeCounts[t]}</span>
          </div>
        ))}
      </div>
    </div>
  </aside>
)}
