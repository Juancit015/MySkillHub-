---
import type { CollectionEntry } from "astro:content";
import SkillCard from "./SkillCard.astro";

export interface Props {
  skills: CollectionEntry<"skills">[];
  locale: "en" | "es";
  base: string;
  sort?: "stars" | "name" | "new";
  ui: any;
  showTabs?: boolean;
}

const { skills, locale, base, sort = "name", ui, showTabs = true } = Astro.props;

const sorted = [...skills].sort((a, b) => {
  if (sort === "name") return a.data.name.localeCompare(b.data.name);
  if (sort === "new") return b.data.created_at.getTime() - a.data.created_at.getTime();
  return 0;
});

const tabTypes = [
  { key: "all", label: ui.tabAll },
  { key: "skill", label: ui.tabSkills },
  { key: "plugin", label: ui.tabPlugins },
  { key: "tool", label: ui.tabTools },
  { key: "collection", label: ui.tabCollections },
] as const;
---

<div class="toolbar">
  {showTabs && (
    <div class="tabs" role="group" aria-label={ui.typeLabel}>
      {tabTypes.map((tab, i) => (
        <button type="button" class:list={["tab", { active: i === 0 }]} data-type-filter={tab.key} role="tab" aria-selected={i === 0}>
          {tab.label}
        </button>
      ))}
    </div>
  )}
  <div class="toolbar-right">
    <div class="results-count" id="results-count">{ui.resultsCount(skills.length)}</div>
    <select class="sort-select" data-sort>
      <option value="name" selected>{ui.sortName}</option>
      <option value="new">{ui.sortNew}</option>
    </select>
  </div>
</div>

{sorted.length === 0 ? (
  <p class="results-count" style="padding:40px 0">{ui.noResults}</p>
) : (
  <div class="grid" id="skills-grid">
    {sorted.map((skill) => (
      <SkillCard
        skill={{
          id: skill.data.id,
          name: skill.data.name,
          description: skill.data.description,
          author: skill.data.author,
          type: skill.data.type,
          license_notice: skill.data.license_notice,
          compatibility: skill.data.compatibility,
          tags: skill.data.tags,
          created_at: skill.data.created_at,
        }}
        href={`${base}/skills/${skill.slug}`}
        locale={locale}
        authorBy={ui.authorBy}
      />
    ))}
  </div>
)}
<p id="search-no-results" style="display: none; padding: 40px 0; color: var(--color-text-muted);">{ui.noResults}</p>
