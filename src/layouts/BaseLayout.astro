---
import "../styles/global.css";
import { getCollection } from "astro:content";

export interface Props {
  title?: string;
  locale?: "en" | "es";
}

const { title = "MyAgentSkills", locale = "en" } = Astro.props;
const path = Astro.url.pathname.replace(/^\/|\/$/g, "");
const segments = path.split("/").filter(Boolean);
const isEs = segments[0] === "es";
const base = isEs ? "/es" : "";

const categories = (await getCollection("categories")).sort((a, b) => a.data.order - b.data.order);
const navCategories = categories.slice(0, 4);

const t = locale === "es" ? {
  tagline: "Encuentra las skills correctas para tu agente de IA.",
} : {
  tagline: "Find the right skills for your AI agent.",
};

const currentPath = Astro.url.pathname;
const cleanPath = isEs ? path.slice(3).replace(/^\//, "") : path;
const enHref = `/${cleanPath}`;
const esHref = `/es/${cleanPath}`;
const isActive = (href: string) =>
  href === `${base}/` ? currentPath === `${base}/` : currentPath.startsWith(href);
---

<html lang={locale}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
  <title>{title}</title>
</head>
<body>
  <header class="site-header">
    <div class="container">
      <a href={`${base}/`} class="logo">
        <span>&gt;_</span> MyAgent<span style="color: var(--color-accent)">Skills</span>
      </a>
      <button class="menu-toggle" id="menu-toggle" aria-label="Menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
      <nav id="site-nav">
        <div class="nav-inner">
        <a href={`${base}/`} class:list={{ active: isActive(`${base}/`) }}>
          {locale === "es" ? "Todas las skills" : "All skills"}
        </a>
        {navCategories.map((cat) => (
          <a href={`${base}/categories/${cat.data.id}`} class:list={{ active: isActive(`${base}/categories/${cat.data.id}`) }}>
            {cat.data.name[locale]}
          </a>
        ))}
        <div class="locale-switch">
          <a href={locale === "en" ? currentPath : enHref} class={locale === "en" ? "active" : ""}>EN</a>
          <a href={locale === "es" ? currentPath : esHref} class={locale === "es" ? "active" : ""}>ES</a>
        </div>
        </div>
      </nav>
    </div>
  </header>
  <slot />
  <footer class="site-footer">
    <div class="container">
      <div class="footer-brand">MyAgentSkills&gt;_</div>
      <p>{t.tagline} &middot; 2026</p>
      <div class="footer-langs">
        <a href={locale === "en" ? currentPath : enHref} class={locale === "en" ? "active" : ""}>EN</a>
        <a href={locale === "es" ? currentPath : esHref} class={locale === "es" ? "active" : ""}>ES</a>
      </div>
    </div>
  </footer>
  <script>
    import { initCatalog } from "../scripts/catalog";
    const toggle = document.getElementById("menu-toggle");
    const nav = document.getElementById("site-nav");
    if (toggle && nav) {
      toggle.addEventListener("click", function () {
        const open = nav.classList.toggle("open");
        toggle.setAttribute("aria-expanded", open ? "true" : "false");
        toggle.classList.toggle("active", open);
      });
      nav.querySelectorAll("a").forEach(function (link) {
        link.addEventListener("click", function () {
          nav.classList.remove("open");
          toggle.classList.remove("active");
          toggle.setAttribute("aria-expanded", "false");
        });
      });
    }
    initCatalog();
  </script>
</body>
</html>
